<mxfile host="HENRI v6" agent="henri-diagrams" version="24.0.0" type="device">
  <diagram id="phase2-ingress" name="Phase 2 Ingress">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="HENRI v6 &#8212; Phase 2 Grounded Multimodal Ingress (D = 65536, D_slot = 16384)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="src_hdr" value="SOURCE (synthetic &#8212; no live sensor)" style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n_field" value="Sensor field I(x, y)&#10;real intensity array 32x32&#10;(synthetic, NOT camera data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n_token" value="Token id triple&#10;(category, semantic, instance)&#10;integer ids, no vocabulary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="enc_hdr" value="ENCODE (Phase 2)" style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="320" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="n_enc" value="ContinuousSpatialEncoder&#10;henri/spatial_encoder.py&#10;&#10;theta_d = 2pi (u_d x + v_d y)&#10;Psi_d = sum_p I(p) exp(i theta_d(p))&#10;&#10;INTEGER lattice 128 x 128 (F10)&#10;2048 Cl(3,0) blocks x 8 grades&#10;&#10;G-ING1 phase residual 2.589e-15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="110" width="320" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="n_tok" value="QFHRRTokenizer&#10;henri/qfhrr_tokenizer.py&#10;&#10;q = (q_cat + q_sem + q_id) mod 256&#10;dtype uint8, ring Z_256&#10;&#10;to_complex_phasor (adapter):&#10;Psi_d = (1/sqrt(D)) exp(i 2pi q_d / 256)&#10;|Psi_d| = 1/128 = 0.0078125 exactly&#10;&#10;G-ING2 1.735e-18   G-ING4 exact&#10;G-U2 6.112605e-05 &#8211; bar 0.12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="340" width="320" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="part_hdr" value="4-SLOT CANONICAL PARTITION &#8212; reuses henri/config.py, no second convention" style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="420" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="s0" value="Slot 0  Entity   [0, 16384)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="110" width="380" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="Slot 1  Action   [16384, 32768)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="152" width="380" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="Slot 2  Target   [32768, 49152)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="194" width="380" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="Slot 3  Context  [49152, 65536)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="236" width="380" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n_router" value="SubspaceRouter.assemble_ingress&#10;henri/ingress_subspace_router.py&#10;&#10;1. insert provided slot vectors&#10;2. ZERO unpopulated slots (constraint C6)&#10;3. global polar normalize  Psi / ||Psi||_2&#10;4. return settled WaveState&#10;&#10;G-U1 bleed 0.0 EXACT (not a tolerance)&#10;G-ING3 tail sum 0.0 EXACT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="310" width="380" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="n_wave" value="WaveState on S^{D-1}&#10;||psi||_2 = 1   (measured norm error 2.220e-16)&#10;slot energy [1.000000, 0, 0, 0] for Entity-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="530" width="380" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="n_gates" value="MEASURED GATES at D = 65536&#10;&#10;PASS (7):&#10;  G-ING1   2.589e-15   &#8211; bar 1e-12&#10;  G-ING1b  1.986e-14&#10;  G-ING2   1.735e-18   &#8211; bar 1e-15&#10;  G-ING4   1.0000000000 &#8211; bar 0.9999&#10;  G-U2     6.112605e-05 &#8211; bar 0.12&#10;  G-U1     0.0          EXACT&#10;  G-ING3   0.0          EXACT&#10;&#10;NEGATIVE CONTROLS (must FAIL):&#10;  unwrapped shift 2.467e-02 &#8211; must exceed 1e-3&#10;  convolution arm 0.713168 &#8211; must be below 0.9999&#10;&#10;The convolution control reproduces F2 saturation&#10;near 1/sqrt(2). The two binding algebras are&#10;separable by measurement, not by prose.&#10;&#10;receipt sha256&#10;daf36e403f08a8d8be8d4dee2836839d&#10;dadd17908880ca19d3e563bab51cddb0&#10;sidecar readback verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="110" width="440" height="510" as="geometry"/>
        </mxCell>

        <mxCell id="e_field_enc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="n_field" target="n_enc">
